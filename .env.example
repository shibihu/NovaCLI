# ---------------------------------------------------------------------------
# NovaCLI v1.0 — example environment file
#
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# `.env` is git-ignored and is NEVER read into the model context.
# ---------------------------------------------------------------------------

# --- AI provider (required) -------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Model (optional) -------------------------------------------------------
# Any Groq chat model id. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Workspace (optional) ---------------------------------------------------
# Root directory the agent is allowed to read and write.
# Defaults to the current working directory.
NOVA_PROJECT_ROOT=

# --- Execution limits (optional) --------------------------------------------
# Seconds any single shell command may run before it is killed.
NOVA_COMMAND_TIMEOUT=30

# Maximum time an LLM provider request may run before timing out (seconds).
# Defaults to 1800 (30 minutes). Local Ollama inference may require longer timeouts.
NOVA_LLM_TIMEOUT=1800

# Maximum agent reasoning steps per task before it stops.
NOVA_MAX_STEPS=8

# --- Safety (optional) ------------------------------------------------------
# smart (default) | strict | permissive
NOVA_SAFETY_MODE=smart

# --- Web IDE (optional) -----------------------------------------------------
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
